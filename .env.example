# Neon PostgreSQL connection string
# Create a free database at https://neon.tech
# Example:
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# JWT secret for session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-here"

# Apify API token (server-side only, optional — mock service used when absent)
APIFY_API_TOKEN=""

# Set to "true" to force Apify when token is present
USE_APIFY="false"

# Public app URL for password reset links (e.g. https://app.creatorpulse.io)
APP_URL="http://localhost:3000"

# Meta / Instagram OAuth (server-side only — see docs/INSTAGRAM_SETUP.md)
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/callback"
# Optional comma-separated scopes (defaults include basic + insights)
# INSTAGRAM_OAUTH_SCOPES="instagram_business_basic,instagram_business_manage_insights"
# Optional dedicated key for encrypting Instagram tokens at rest (falls back to AUTH_SECRET)
# INSTAGRAM_TOKEN_ENCRYPTION_KEY=""

# Optional SMTP for password reset emails (dev logs link to console when unset)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="CreatorPulse <noreply@creatorpulse.app>"
